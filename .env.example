# Copy to `.env` (git-ignored) and fill in. Loaded automatically by `kagome_vqe.config.Settings`.
#
# API token from https://quantum.cloud.ibm.com (Account -> API key).
IBM_QUANTUM_TOKEN=
# Cloud Resource Name (CRN) of the instance to charge. Optional if your account has one instance.
IBM_QUANTUM_INSTANCE=
# Leave as-is unless IBM changes channel names. The old "ibm_quantum" channel is retired.
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
# Optional region hint: us-east or eu-de.
IBM_QUANTUM_REGION=
